CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Memory — THP, CMA, Compaction, idle page tracking
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_CMA=y
CONFIG_COMPACTION=y
CONFIG_IDLE_PAGE_TRACKING=y
CONFIG_ZONE_MOVABLE_CMA=y
CONFIG_EMERGENCY_MEMORY=y

# PSI — Pressure Stall Information (Android ActivityManager uses this)
CONFIG_PSI=y

# Kernel Hardening — Fortify + usercopy bounds checking
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y
CONFIG_SECURITYFS=y
# SHADOW_CALL_STACK disabled — MTK TrustZone clobbers x18 register
# causing "corrupted shadow stack detected inside scheduler" kernel panic
# after ~2 hours uptime. TEE does not preserve x18 (shadow stack pointer).
# CONFIG_SHADOW_CALL_STACK is not set
# SLAB_FREELIST_HARDENED/RANDOM disabled — MTK modem driver (CCCI/CLDMA) has
# use-after-free in ccci_free_skb → SLAB_FREELIST_HARDENED detects corruption
# and triggers BUG() → kernel panic after ~81 min uptime.
# CONFIG_SLAB_FREELIST_HARDENED is not set
# CONFIG_SLAB_FREELIST_RANDOM is not set

# Kernel Self Protection — kernel text read-only only
# NOTE: Several hardening configs DISABLED due to MTK vendor driver incompatibilities
# INIT_ON_ALLOC_DEFAULT_ON → bootloop (vendor drivers depend on uninit memory)
# BUG_ON_DATA_CORRUPTION → bootloop (vendor drivers have benign list corruption)
# SLAB_FREELIST_HARDENED → modem crash (CCCI/CLDMA use-after-free)
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
CONFIG_STRICT_KERNEL_RWX=y

# Additional TCP Congestion Control (Westwood for cellular, BIC)
CONFIG_TCP_CONG_WESTWOOD=y
# CONFIG_TCP_CONG_BIC is not set

# ASHMEM — Android shared memory (vendor HAL compat)
CONFIG_ASHMEM=y

# ZSWAP disabled — redundant with ZRAM (CPU compression overhead)
# CONFIG_ZSWAP is not set
# CONFIG_ZPOOL is not set

# TASKSTATS — per-task performance accounting
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y

# SCHED_HMP — Heterogeneous Multi-Processing for big.LITTLE (2x A75 + 6x A55)
# NOTE: CONFIG_SCHED_AUTOGROUP disabled (conflicts with HMP, less relevant on Android)
# CONFIG_SCHED_AUTOGROUP is not set
CONFIG_SCHED_HMP=y
CONFIG_SCHED_HMP_PLUS=y
CONFIG_SCHED_HMP_PRIO_FILTER=y
CONFIG_HMP_FREQUENCY_INVARIANT_SCALE=y
CONFIG_MTK_SCHED_INTEROP=y
CONFIG_MTK_SCHED_EAS_POWER_SUPPORT=y
CONFIG_MTK_SCHED_MULTI_GEARS=y
CONFIG_MTK_SCHED_BL_FIRST=y
CONFIG_MTK_SCHED_RQAVG_KS=y
CONFIG_MTK_SCHED_RQAVG_US=y
CONFIG_MTK_SCHED_CPULOAD=y
CONFIG_MTK_SCHED_SYSHINT=y

# MTK Performance — Touch Boost, Load Tracker, IO Boost, Task Turbo
CONFIG_MTK_PERFMGR_TOUCH_BOOST=y
CONFIG_MTK_LOAD_TRACKER=y
CONFIG_MTK_SCHED_BOOST=y
CONFIG_MTK_CPU_CTRL_CFP=y
# MTK_IO_BOOST disabled — eMMC is bottleneck, not CPU
# CONFIG_MTK_IO_BOOST is not set
# MTK_TASK_TURBO disabled — boost→throttle cycle worse than steady perf
# CONFIG_MTK_TASK_TURBO is not set
CONFIG_MTK_GBE=y
CONFIG_MTK_EARA_AI=y
CONFIG_MTK_PERF_OBSERVER=y
CONFIG_MTK_PERF_TRACKER=y
CONFIG_MTK_RESYM=y

# MTK Power — SWPM, QoS V1 (DRAM BW management)
CONFIG_MTK_SWPM=y
# CONFIG_MTK_QOS_FRAMEWORK is not set
CONFIG_MTK_QOS_V1=y
# CONFIG_MTK_QOS_V2 is not set

# MTK RAM Console — crash log persistence
CONFIG_MTK_RAM_CONSOLE=y

# PGTABLE_MAPPING — page table mapping for zsmalloc (faster ZRAM)
CONFIG_PGTABLE_MAPPING=y

# Speculative Page Fault — reduces mmap_sem contention, multi-thread perf
CONFIG_SPECULATIVE_PAGE_FAULT=y

# PROCESS_RECLAIM — targeted memory reclaim via /proc/pid/reclaim
CONFIG_PROCESS_RECLAIM=y

# MEMCG_SWAP — per-cgroup swap accounting
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y

# CPU governor — performance governor for benchmarking
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y

# MQ I/O schedulers disabled — eMMC uses legacy block layer
# CONFIG_MQ_IOSCHED_KYBER is not set

# Default I/O scheduler — deadline for legacy block layer eMMC
CONFIG_DEFAULT_DEADLINE=y
CONFIG_DEFAULT_IOSCHED="deadline"

# KSM disabled — save CPU cycles during app transitions (tunable at runtime)
# CONFIG_KSM is not set

# SQUASHFS — Custom ROM vendor partition compatibility
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y

